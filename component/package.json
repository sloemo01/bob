{
  "name": "bob-faces",
  "version": "1.0.0",
  "private": true,
  "description": "bob \u00b7 faces \u2014 24 morphing SVG faces as a drop-in React component (engine + data packed in)",
  "type": "module",
  "main": "./dist/bob.cjs",
  "module": "./dist/bob.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/bob.js",
      "require": "./dist/bob.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.d.ts",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "bash build.sh"
  }
}
