{
  "name": "@sloemo/bob",
  "version": "1.1.1",
  "description": "bob: the morphing character and his typing scene as drop-in React components (engine + data packed in)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/bob.cjs",
  "module": "./dist/bob.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/bob.js",
      "require": "./dist/bob.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.d.ts",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sloemo01/bob.git",
    "directory": "component"
  },
  "homepage": "https://github.com/sloemo01/bob",
  "bugs": {
    "url": "https://github.com/sloemo01/bob/issues"
  },
  "keywords": [
    "react",
    "svg",
    "morph",
    "animation",
    "character",
    "faces",
    "typing",
    "typewriter"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "bash build.sh",
    "prepublishOnly": "bash build.sh"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
